# Copy this file to `.env` and fill in real values.

# Postgres connection string for Prisma Next (Supabase: Settings > Database > Connection string,
# "Session pooler" or direct connection, with your database password filled in).
# Requires PostgreSQL >= 17.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Supabase project API settings (Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
